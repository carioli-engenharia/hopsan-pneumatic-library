  <system typename="Subsystem" name="05_32_Cilindro_Simples_Acao" subtypename="" cqstype="UndefinedCQSType">
    <simulationtime start="0" stop="4" timestep=".00005" inherit_timestep="true" />
    <simulationlogsettings starttime="0" numsamples="2001" />
    <parameters />
    <aliases />
    <hopsangui>
      <pose x="0" y="0" a="0" flipped="false" />
      <viewport x="350" y="250" zoom=".9" />
      <names hidden="0" />
